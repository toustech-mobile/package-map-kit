{
  "version": 8,
  "name": "Map Kit Google-inspired Light v1",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors, OpenMapTiles, OpenFreeMap"
    }
  },
  "layers": [
    {"id": "land", "type": "background", "paint": {"background-color": "#F1F3F4"}},
    {"id": "landcover", "type": "fill", "source": "basemap", "source-layer": "landcover", "paint": {"fill-color": "#CEEAD6"}},
    {"id": "residential", "type": "fill", "source": "basemap", "source-layer": "landuse", "filter": ["==", "class", "residential"], "paint": {"fill-color": "#F1F3F4"}},
    {"id": "parks", "type": "fill", "source": "basemap", "source-layer": "park", "paint": {"fill-color": "#CEEAD6"}},
    {"id": "water", "type": "fill", "source": "basemap", "source-layer": "water", "paint": {"fill-color": "#AECBFA"}},
    {"id": "waterways", "type": "line", "source": "basemap", "source-layer": "waterway", "paint": {"line-color": "#AECBFA", "line-width": 1}},
    {"id": "buildings", "type": "fill", "source": "basemap", "source-layer": "building", "minzoom": 13, "paint": {"fill-color": "#E8EAED", "fill-outline-color": "#DADCE0"}},
    {
      "id": "road-casing", "type": "line", "source": "basemap", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#DADCE0", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 12, 2, 16, 8, 18, 16]}
    },
    {
      "id": "roads", "type": "line", "source": "basemap", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#FFFFFF", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 12, 1, 16, 6, 18, 14]}
    },
    {
      "id": "highways", "type": "line", "source": "basemap", "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#FDE293", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 12, 2, 16, 7, 18, 15]}
    },
    {
      "id": "boundaries", "type": "line", "source": "basemap", "source-layer": "boundary",
      "paint": {"line-color": "#BDC1C6", "line-width": 0.8, "line-dasharray": [3, 2]}
    },
    {
      "id": "road-labels", "type": "symbol", "source": "basemap", "source-layer": "transportation_name", "minzoom": 12,
      "layout": {"symbol-placement": "line", "text-field": "{name}", "text-size": 11},
      "paint": {"text-color": "#5F6368", "text-halo-color": "#FFFFFF", "text-halo-width": 1.5}
    },
    {
      "id": "place-labels", "type": "symbol", "source": "basemap", "source-layer": "place",
      "layout": {"text-field": "{name}", "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 12, 15]},
      "paint": {"text-color": "#3C4043", "text-halo-color": "#FFFFFF", "text-halo-width": 1.5}
    }
  ]
}
